<view class="page page-enter">
  <view class="flex-col items-center" style="padding-top: 40px;">
    <view class="scan-icon">📷</view>
    <text class="text-lg text-bold mt-12">扫码查商品</text>
    <text class="text-sm text-secondary mt-8 mb-24">扫描商品条形码，快速查询库存信息</text>

    <button class="btn btn-primary btn-block" bindtap="onScan">开始扫码</button>

    <view wx:if="{{result}}" class="card mt-24" style="width:100%;">
      <view class="flex-row justify-between mb-8">
        <text class="text-bold text-lg">{{result.name}}</text>
      </view>
      <view class="info-row"><text class="info-label">条形码</text><text class="info-value">{{result.barcode}}</text></view>
      <view class="info-row"><text class="info-label">SKU</text><text class="info-value">{{result.sku || '-'}}</text></view>
      <view class="info-row"><text class="info-label">售价</text><text class="info-value">¥{{result.salePrice}}</text></view>
    </view>

    <view wx:if="{{errorMsg}}" class="card mt-12" style="width:100%;background:#fef2f2;border:1px solid #fecaca;">
      <text class="text-danger">{{errorMsg}}</text>
    </view>

    <button wx:if="{{result}}" class="btn btn-secondary btn-block mt-12" bindtap="onScanAgain">继续扫码</button>
  </view>
</view>
