<view class="page page-enter">
  <view class="section-header">
    <text class="section-title">调拨管理</text>
    <button class="btn btn-primary btn-sm" bindtap="onShowCreate">+ 新建</button>
  </view>

  <view wx:if="{{loading && list.length === 0}}" class="loading-center"><view class="loading-spinner"></view></view>
  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <text class="empty-icon">🚚</text>
    <text class="empty-text">暂无调拨记录</text>
  </view>

  <view wx:else>
    <view class="card transfer-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="flex-row justify-between items-center">
        <view>
          <view class="flex-row items-center gap-8">
            <text class="text-bold">{{item.orderNo || '调拨单'}}</text>
            <status-tag status="{{item.status}}"></status-tag>
          </view>
          <view class="flex-row items-center gap-8 mt-4">
            <text class="text-sm text-secondary">{{item.fromWarehouse && item.fromWarehouse.name ? item.fromWarehouse.name : '-'}}</text>
            <text class="text-sm text-muted">→</text>
            <text class="text-sm text-secondary">{{item.toWarehouse && item.toWarehouse.name ? item.toWarehouse.name : '-'}}</text>
          </view>
        </view>
      </view>
      <text class="text-xs text-muted mt-8">{{item.createdAt}}</text>
    </view>
    <view wx:if="{{loading}}" class="loading-center"><view class="loading-spinner"></view></view>
    <view wx:elif="{{!hasMore && list.length > 0}}" class="text-center text-muted text-sm" style="padding: 12px 0;">已加载全部</view>
  </view>

  <!-- Create Modal -->
  <view wx:if="{{showCreate}}" class="modal-mask" bindtap="onHideCreate">
    <view class="modal-content" catchtap>
      <text class="modal-title">新建调拨单</text>
      <view class="form-group">
        <text class="form-label">调出仓库</text>
        <picker class="form-picker" mode="selector" range="{{warehouses}}" range-key="name" value="{{fromIndex}}" bindchange="onFromChange">
          <text wx:if="{{fromIndex >= 0}}">{{warehouses[fromIndex].name}}</text>
          <text wx:else class="text-muted">请选择</text>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">调入仓库</text>
        <picker class="form-picker" mode="selector" range="{{warehouses}}" range-key="name" value="{{toIndex}}" bindchange="onToChange">
          <text wx:if="{{toIndex >= 0}}">{{warehouses[toIndex].name}}</text>
          <text wx:else class="text-muted">请选择</text>
        </picker>
      </view>
      <view class="section-header">
        <text class="form-label">调拨商品</text>
        <button class="btn btn-primary btn-xs" bindtap="onAddProduct">+ 添加</button>
      </view>
      <view wx:if="{{items.length === 0}}" class="text-center text-muted" style="padding: 20px 0;">请添加调拨商品</view>
      <view wx:for="{{items}}" wx:key="productId" class="list-item">
        <view class="flex-row justify-between items-center gap-8">
          <text class="flex-1">{{item.productName}}</text>
          <input class="form-input" style="width: 80px; height: 36px;" type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="onQuantityInput" />
          <text class="text-danger" data-index="{{index}}" bindtap="onRemoveItem">删除</text>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
      </view>
      <button class="btn btn-primary btn-block mt-8" loading="{{submitting}}" disabled="{{submitting || fromIndex < 0 || toIndex < 0 || fromIndex === toIndex || items.length === 0}}" bindtap="onSubmit">创建调拨单</button>
      <view class="modal-close" bindtap="onHideCreate">取消</view>
    </view>
  </view>

  <!-- Product Search -->
  <view wx:if="{{showProductSearch}}" class="modal-mask" bindtap="onCloseSearch">
    <view class="modal-content" catchtap>
      <text class="modal-title">选择商品</text>
      <view class="search-bar"><input class="search-input" placeholder="搜索商品" value="{{productSearch}}" bindinput="onProductSearchInput" /></view>
      <scroll-view scroll-y style="max-height: 400rpx;">
        <view wx:for="{{searchResults}}" wx:key="id" class="list-item" data-product="{{item}}" bindtap="onSelectProduct">
          <text>{{item.name}}</text>
          <text class="text-sm text-muted ml-8">¥{{item.costPrice}}</text>
        </view>
        <view wx:if="{{searchResults.length === 0 && productSearch}}" class="text-center text-muted p-12">未找到</view>
      </scroll-view>
      <view class="modal-close" bindtap="onCloseSearch">取消</view>
    </view>
  </view>
</view>
