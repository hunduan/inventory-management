/* 更多页 - Warm Minimalist */

.more-profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  cursor: pointer;
}

.more-profile:active {
  opacity: 0.8;
}

.more-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #0f766e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  flex-shrink: 0;
}

.more-user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.more-arrow {
  font-size: 20px;
  flex-shrink: 0;
}

.more-menu {
  padding: 0;
}

.more-menu-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #f0f0f0;
  cursor: pointer;
}

.more-menu-item:last-child {
  border-bottom: none;
}

.more-menu-item:active {
  background: #fafaf9;
}

.more-menu-icon {
  font-size: 20px;
  margin-right: 12px;
}

.more-menu-text {
  flex: 1;
  font-size: 15px;
  color: #1c1917;
}

.more-menu-arrow {
  color: #a8a29e;
  font-size: 18px;
}
