/* 更多页 */

.more-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 24px;
}

.more-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 8px;
  background: #ffffff;
  border-radius: 8px;
  border: 1px solid #e7e5e4;
}

.more-item-icon {
  font-size: 28px;
  margin-bottom: 8px;
}

.more-item-text {
  font-size: 12px;
  color: #1c1917;
}
