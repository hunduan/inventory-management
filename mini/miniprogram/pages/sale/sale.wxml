<view class="page page-enter">
  <view wx:if="{{loading}}" class="loading-center">
    <view class="loading-spinner"></view>
  </view>

  <view wx:else>
    <text class="text-xl text-bold mb-16">{{isEdit ? '编辑销售单' : '新建销售单'}}</text>

    <view class="card">
      <view class="form-group">
        <text class="form-label">客户</text>
        <picker class="form-picker" mode="selector" range="{{customers}}" range-key="name" value="{{customerIndex}}" bindchange="onCustomerChange">
          <text wx:if="{{customerIndex >= 0}}" class="text-base">{{customers[customerIndex].name}}</text>
          <text wx:else class="text-muted">请选择客户</text>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">出库仓库</text>
        <picker class="form-picker" mode="selector" range="{{warehouses}}" range-key="name" value="{{warehouseIndex}}" bindchange="onWarehouseChange">
          <text wx:if="{{warehouseIndex >= 0}}" class="text-base">{{warehouses[warehouseIndex].name}}</text>
          <text wx:else class="text-muted">请选择仓库</text>
        </picker>
      </view>
    </view>

    <!-- Items Section -->
    <view class="card">
      <view class="section-header">
        <text class="section-title">商品明细</text>
        <view class="flex-row gap-4">
          <button class="btn btn-outline btn-xs" bindtap="onScanBarcode">📷 扫码</button>
          <button class="btn btn-outline btn-xs" bindtap="onToggleSmartInput">✏️ 录入</button>
          <button class="btn btn-primary btn-xs" bindtap="onAddProduct">+ 添加</button>
        </view>
      </view>
      <view wx:if="{{items.length === 0}}" class="text-center p-12">
        <text class="text-muted">点击"添加商品"选择商品</text>
      </view>
      <view wx:for="{{items}}" wx:key="productId" class="p-12">
        <view class="flex-row justify-between items-center">
          <view class="flex-1">
            <text class="text-bold">{{item.productName}}</text>
            <text class="text-sm text-muted mt-4">售价: ¥{{item.unitPrice}}</text>
          </view>
          <text class="text-danger" data-index="{{index}}" bindtap="onRemoveItem">删除</text>
        </view>
        <view class="gap-12 mt-8">
          <view class="flex-1">
            <text class="form-label">数量</text>
            <input class="form-input" type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="onQuantityInput" />
          </view>
          <view class="flex-1">
            <text class="form-label">单价</text>
            <input class="form-input" type="digit" value="{{item.unitPrice}}" data-index="{{index}}" bindinput="onPriceInput" />
          </view>
        </view>
        <text class="text-sm text-secondary mt-4">小计: ¥{{item.subtotal.toFixed(2)}}</text>
      </view>
    </view>

    <!-- Total -->
    <view class="card flex-row justify-between items-center">
      <text class="text-base text-bold">合计</text>
      <text class="text-xl text-bold text-primary">¥{{totalAmount.toFixed(2)}}</text>
    </view>

    <view class="form-group">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
    </view>

    <button class="btn btn-primary btn-block" loading="{{submitting}}" disabled="{{submitting || items.length === 0}}" bindtap="onSubmit">
      {{isEdit ? '保存修改' : '创建销售单'}}
    </button>
  </view>

  <!-- Product Search Bottom Sheet -->
  <view wx:if="{{showProductSearch}}" class="modal-mask" bindtap="onCloseSearch">
    <view class="modal-content" catchtap>
      <text class="modal-title">选择商品</text>
      <view class="search-bar">
        <input class="search-input" placeholder="搜索商品名称" value="{{productSearch}}" bindinput="onProductSearchInput" />
      </view>
      <view class="divider"></view>
      <scroll-view scroll-y style="max-height: 400rpx;">
        <view wx:if="{{searchLoading}}" class="loading-center"><view class="loading-spinner"></view></view>
        <view wx:elif="{{searchResults.length === 0 && productSearch}}" class="text-center text-muted p-12">未找到匹配商品</view>
        <view wx:elif="{{searchResults.length === 0}}" class="text-center text-muted p-12">输入商品名称搜索</view>
        <view wx:for="{{searchResults}}" wx:key="id" class="list-item" data-product="{{item}}" bindtap="onSelectProduct">
          <view class="flex-row justify-between items-center">
            <view>
              <text class="text-bold">{{item.name}}</text>
              <text wx:if="{{item.barcode}}" class="text-sm text-muted ml-8">{{item.barcode}}</text>
            </view>
            <text class="text-sm text-primary">¥{{item.salePrice}}</text>
          </view>
        </view>
      </scroll-view>
      <button class="btn btn-secondary btn-block" bindtap="onCloseSearch">取消</button>
    </view>
  </view>

  <!-- Smart Input Bottom Sheet -->
  <view wx:if="{{showSmartInput}}" class="modal-mask" bindtap="onToggleSmartInput">
    <view class="modal-content" catchtap>
      <text class="modal-title">智能录入</text>
      <text class="text-sm text-secondary mb-12">输入商品和数量，例如"苹果10个，牛奶5瓶"</text>
      <textarea class="form-textarea" value="{{smartText}}" bindinput="onSmartTextInput" placeholder="销售苹果10个，牛奶5瓶" style="min-height:100px;" />
      <view wx:if="{{unresolvedNames.length > 0}}" class="mt-12">
        <text class="text-sm text-danger">以下商品未匹配到，请手动添加：</text>
        <view wx:for="{{unresolvedNames}}" wx:key="this" class="text-sm text-muted mt-4">{{item}}</view>
      </view>
      <button class="btn btn-primary btn-block mt-12" loading="{{parsing}}" disabled="{{!smartText.trim()}}" bindtap="onParseSmartText">解析并添加</button>
      <button class="btn btn-secondary btn-block mt-8" bindtap="onToggleSmartInput">关闭</button>
    </view>
  </view>
</view>
