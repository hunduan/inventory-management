<view class="page page-enter">
  <!-- Header + Create Button -->
  <view class="section-header">
    <text class="section-title">销售订单</text>
    <button class="btn btn-primary btn-sm" bindtap="onCreate">+ 新建</button>
  </view>

  <!-- Status Tabs -->
  <view class="tabs">
    <view wx:for="{{statusTabs}}" wx:key="value"
      class="tab {{statusFilter === item.value ? 'tab-active' : ''}}"
      data-status="{{item.value}}"
      bindtap="onTabChange">{{item.label}}</view>
  </view>

  <!-- Orders List -->
  <view wx:if="{{loading && orders.length === 0}}" class="loading-center">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{orders.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无销售订单</text>
    <button class="btn btn-primary btn-sm" bindtap="onCreate">创建销售单</button>
  </view>

  <view wx:else>
    <view class="card order-item" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap">
      <view class="flex-row justify-between items-center">
        <view class="flex-row items-center gap-8">
          <text class="text-bold">{{item.orderNo}}</text>
        </view>
        <status-tag status="{{item.status}}"></status-tag>
      </view>
      <view class="flex-row justify-between items-center mt-4">
        <view>
          <text class="text-sm text-secondary">{{item.customer && item.customer.name ? item.customer.name : '-'}}</text>
          <text wx:if="{{item.warehouse && item.warehouse.name}}" class="text-sm text-secondary ml-8">{{item.warehouse.name}}</text>
        </view>
        <text class="text-base text-bold text-primary">¥{{item.totalAmount}}</text>
      </view>
      <text class="text-xs text-muted mt-4">{{item.createdAt}}</text>
    </view>

    <!-- Load More -->
    <view wx:if="{{loading}}" class="loading-center" style="padding: 16px 0;">
      <view class="loading-spinner"></view>
    </view>
    <view wx:elif="{{!hasMore && orders.length > 0}}" class="text-center text-muted text-sm" style="padding: 12px 0;">
      已加载全部
    </view>
  </view>
</view>
