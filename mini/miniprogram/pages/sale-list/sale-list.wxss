.tab-row {
  display: flex;
  gap: 0;
  margin-bottom: 12px;
  background: #f5f5f4;
  border-radius: 8px;
  padding: 2px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 6px 4px;
  font-size: 13px;
  color: #78716c;
  border-radius: 6px;
}

.tab-active {
  background: #ffffff;
  color: #0f766e;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0,0,0,0.06);
}
