/* 报表页 */

.date-row {
  display: flex;
  align-items: center;
  padding: 12px 16px;
}

.date-picker {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg, #f5f5f4);
  border-radius: var(--radius-input, 8px);
  padding: 8px 12px;
}

.date-label {
  font-size: 12px;
  color: var(--text-muted, #a8a29e);
  margin-right: 6px;
}

.date-value {
  font-size: 14px;
  font-weight: 500;
  color: var(--text, #1c1917);
}

.date-sep {
  margin: 0 8px;
  color: var(--text-muted, #a8a29e);
  font-size: 13px;
}

.report-item {
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.report-item:last-child {
  border-bottom: none;
}

.report-item-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--text, #1c1917);
  flex: 1;
  min-width: 0;
}

.report-item-amount {
  font-size: 14px;
  font-weight: 600;
  color: var(--text, #1c1917);
  display: block;
}

.report-item-count {
  font-size: 11px;
  color: var(--text-muted, #a8a29e);
  margin-top: 2px;
  display: block;
  text-align: right;
}

/* Override kpi-card width when in 2-column grid */
.grid-2.kpi-grid > .kpi-card {
  width: 50%;
}
