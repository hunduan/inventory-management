<view class="page page-enter">
  <!-- Date & Greeting -->
  <view class="home-header">
    <view class="home-greeting">
      <text class="home-greeting-text">{{user ? user.name + ',' : ''}} 欢迎回来</text>
      <text class="home-date">{{dateStr}}</text>
    </view>
  </view>

  <!-- KPI Cards -->
  <view class="kpi-grid">
    <view class="kpi-card" bindtap="onQuickAction" data-id="purchase">
      <text class="kpi-label">今日采购额</text>
      <text class="kpi-value">¥{{kpi.todayPurchases}}</text>
    </view>
    <view class="kpi-card" bindtap="onQuickAction" data-id="sale">
      <text class="kpi-label">今日销售额</text>
      <text class="kpi-value">¥{{kpi.todaySales}}</text>
    </view>
    <view class="kpi-card" bindtap="onQuickAction" data-id="inventory">
      <text class="kpi-label">库存预警</text>
      <text class="kpi-value" style="{{kpi.alertCount > 0 ? 'color: #dc2626;' : ''}}">{{kpi.alertCount}}</text>
      <text class="kpi-unit">项</text>
    </view>
  </view>

  <!-- Quick Actions -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">快捷操作</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{quickActions}}" wx:key="id" data-id="{{item.id}}" bindtap="onQuickAction">
        <view class="quick-icon-wrap" style="background: {{item.bg}};">
          <text class="quick-icon-text">{{item.icon}}</text>
        </view>
        <text class="quick-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- Recent Orders -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近订单</text>
    </view>

    <view wx:if="{{loading}}" class="loading-center">
      <view class="loading-spinner"></view>
      <text class="text-sm text-secondary mt-8">加载中...</text>
    </view>

    <view wx:elif="{{recentOrders.length > 0}}">
      <view class="card order-card" wx:for="{{recentOrders}}" wx:key="id" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="onOrderTap">
        <view class="flex-row justify-between items-center">
          <view class="flex-row items-center gap-8">
            <text class="text-bold">{{item.orderNo}}</text>
            <text wx:if="{{item.type === 'PURCHASE'}}" class="badge badge-info">采购</text>
            <text wx:else class="badge badge-warning">销售</text>
          </view>
          <text class="badge badge-{{item.status === 'CONFIRMED' ? 'info' : item.status === 'RECEIVED' || item.status === 'DELIVERED' || item.status === 'COMPLETED' ? 'success' : item.status === 'CANCELLED' ? 'danger' : item.status === 'DRAFT' || item.status === 'IN_PROGRESS' ? 'warning' : 'default'}}">{{item.status}}</text>
        </view>
        <view class="flex-row justify-between items-center mt-8">
          <text class="text-lg text-bold text-primary">¥{{item.totalAmount}}</text>
          <text class="text-sm text-secondary">{{item.createdAt}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无最近订单</text>
    </view>
  </view>
</view>
