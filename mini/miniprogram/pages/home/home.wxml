<view class="page">
  <!-- KPI 卡片 -->
  <view class="kpi-row">
    <view class="kpi-card">
      <text class="kpi-label">今日采购额</text>
      <text class="kpi-value">{{dashboard.todayPurchaseTotal || 0}}</text>
      <text class="kpi-unit">元</text>
    </view>
    <view class="kpi-card">
      <text class="kpi-label">今日销售额</text>
      <text class="kpi-value">{{dashboard.todaySaleTotal || 0}}</text>
      <text class="kpi-unit">元</text>
    </view>
    <view class="kpi-card kpi-card-alert">
      <text class="kpi-label">库存预警</text>
      <text class="kpi-value kpi-value-alert">{{dashboard.alertCount || 0}}</text>
      <text class="kpi-unit">项</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="section-header">
    <text class="section-header-title">快捷操作</text>
  </view>
  <view class="quick-grid">
    <view class="quick-item" wx:for="{{quickActions}}" wx:key="id" data-id="{{item.id}}" bindtap="onQuickAction">
      <text class="quick-icon">{{item.icon}}</text>
      <text class="quick-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="section-header mt-16">
    <text class="section-header-title">最近订单</text>
  </view>

  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="text-sm text-secondary mt-8">加载中...</text>
  </view>

  <view wx:elif="{{dashboard.recentOrders && dashboard.recentOrders.length > 0}}">
    <view class="card" wx:for="{{dashboard.recentOrders}}" wx:key="id" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="onViewOrder">
      <view class="flex-row justify-between">
        <text class="text-bold">{{item.orderNo}}</text>
        <text class="text-sm">{{item.type === 'PURCHASE' ? '采购' : '销售'}}</text>
      </view>
      <view class="flex-row justify-between mt-8">
        <text class="text-lg text-bold">{{item.totalAmount}}元</text>
        <text class="text-sm text-secondary">{{item.createdAt}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-state-icon">📋</text>
    <text class="empty-state-text">暂无订单</text>
  </view>
</view>
