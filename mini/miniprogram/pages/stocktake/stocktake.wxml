<view class="page page-enter">
  <view class="section-header">
    <text class="section-title">盘点管理</text>
    <button class="btn btn-primary btn-sm" bindtap="onShowCreate">+ 新建</button>
  </view>

  <view wx:if="{{loading}}" class="loading-center"><view class="loading-spinner"></view></view>

  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">暂无盘点记录</text>
  </view>

  <view wx:else>
    <view class="card stocktake-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="flex-row justify-between items-center">
        <view>
          <text class="text-bold">{{item.warehouse && item.warehouse.name ? item.warehouse.name : '-'}}</text>
          <text class="text-sm text-muted mt-4">{{item.remark || '无备注'}}</text>
        </view>
        <status-tag status="{{item.status}}"></status-tag>
      </view>
      <text class="text-xs text-secondary mt-8">{{item.createdAt}}</text>
    </view>
  </view>

  <!-- Create Modal -->
  <view wx:if="{{showCreate}}" class="modal-mask" bindtap="onHideCreate">
    <view class="modal-content" catchtap>
      <text class="modal-title">新建盘点单</text>
      <view class="form-group">
        <text class="form-label">盘点仓库</text>
        <picker class="form-picker" mode="selector" range="{{warehouses}}" range-key="name" value="{{warehouseIndex}}" bindchange="onWarehouseChange">
          <text wx:if="{{warehouseIndex >= 0}}">{{warehouses[warehouseIndex].name}}</text>
          <text wx:else class="text-muted">请选择仓库</text>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
      </view>
      <view class="section-header">
        <text class="form-label">盘点商品</text>
        <button class="btn btn-primary btn-xs" bindtap="onAddProduct">+ 添加</button>
      </view>
      <view wx:if="{{items.length === 0}}" class="text-center text-muted" style="padding: 20px 0;">请添加盘点商品</view>
      <view wx:for="{{items}}" wx:key="productId" class="list-item">
        <view class="flex-row justify-between items-center">
          <text class="flex-1">{{item.productName}}</text>
          <text class="text-sm text-secondary">账面: {{item.bookQuantity}}</text>
          <text class="text-danger ml-8" data-index="{{index}}" bindtap="onRemoveItem">删除</text>
        </view>
      </view>
      <button class="btn btn-primary btn-block mt-16" loading="{{submitting}}" disabled="{{submitting || warehouseIndex < 0 || items.length === 0}}" bindtap="onSubmit">创建盘点单</button>
      <view class="modal-close" bindtap="onHideCreate">取消</view>
    </view>
  </view>

  <!-- Product Search -->
  <view wx:if="{{showProductSearch}}" class="modal-mask" bindtap="onCloseSearch">
    <view class="modal-content" catchtap>
      <text class="modal-title">添加商品</text>
      <view class="search-bar"><input class="search-input" placeholder="搜索商品" value="{{productSearch}}" bindinput="onProductSearchInput" /></view>
      <scroll-view scroll-y style="max-height: 400rpx;">
        <view wx:for="{{searchResults}}" wx:key="id" class="list-item" data-product="{{item}}" bindtap="onSelectProduct">
          <text>{{item.name}}</text>
        </view>
        <view wx:if="{{searchResults.length === 0 && productSearch}}" class="text-center text-muted p-12">未找到</view>
      </scroll-view>
      <view class="modal-close" bindtap="onCloseSearch">取消</view>
    </view>
  </view>
</view>
