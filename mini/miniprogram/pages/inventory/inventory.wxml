<view class="page page-enter">
  <!-- Header -->
  <view class="section-header">
    <text class="section-title">库存查询</text>
    <button class="btn {{showAlerts ? 'btn-primary' : 'btn-secondary'}} btn-xs" bindtap="onToggleAlerts">
      {{showAlerts ? '全部库存' : '库存预警'}}
    </button>
  </view>

  <!-- Filters -->
  <view class="card" style="padding: 12px;">
    <view class="flex-row gap-8">
      <picker class="form-picker flex-1" style="margin-bottom: 0;" mode="selector" range="{{warehouses}}" range-key="name" value="{{warehouseIndex}}" bindchange="onWarehouseChange">
        <text wx:if="{{warehouseIndex >= 0}}">{{warehouses[warehouseIndex].name}}</text>
        <text wx:else class="text-muted">全部仓库</text>
      </picker>
      <view class="search-bar flex-1" style="margin-bottom: 0;">
        <input class="search-input" placeholder="搜索商品" value="{{searchQuery}}" bindinput="onSearchInput" bindconfirm="onSearch" />
      </view>
      <button class="btn btn-primary btn-sm" bindtap="onSearch">搜索</button>
    </view>
  </view>

  <!-- List -->
  <view wx:if="{{loading && items.length === 0}}" class="loading-center">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <text class="empty-icon">📊</text>
    <text class="empty-text">{{showAlerts ? '暂无预警商品' : '暂无库存数据'}}</text>
  </view>

  <view wx:else>
    <view class="card inventory-item" wx:for="{{items}}" wx:key="id" data-product="{{item.product}}" data-warehouse="{{item.warehouse}}" bindtap="onProductTap">
      <view class="flex-row justify-between items-start">
        <view class="flex-1">
          <text class="text-bold">{{item.product && item.product.name ? item.product.name : '-'}}</text>
          <text wx:if="{{item.product && item.product.barcode}}" class="text-sm text-muted">{{item.product.barcode}}</text>
        </view>
        <view class="text-right">
          <text class="text-lg text-bold" style="color: {{(item.quantity || 0) <= (item.product && item.product.minStock ? item.product.minStock : 0) ? '#dc2626' : '#1c1917'}};">
            {{item.quantity || 0}}
          </text>
          <text class="text-sm text-secondary">{{item.warehouse && item.warehouse.name ? item.warehouse.name : '-'}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-center"><view class="loading-spinner"></view></view>
    <view wx:elif="{{!hasMore && items.length > 0}}" class="text-center text-muted text-sm" style="padding: 12px 0;">已加载全部</view>
  </view>
</view>
