<view class="page page-enter">
  <view wx:if="{{loading}}" class="loading-center">
    <view class="loading-spinner loading-spinner-lg"></view>
    <text class="text-sm text-secondary mt-8">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="empty-state">
    <text class="empty-icon">&#x26A0;&#xFE0F;</text>
    <text class="empty-text">{{error}}</text>
    <button class="btn btn-primary btn-sm" bindtap="loadOrder">重试</button>
  </view>

  <view wx:elif="{{order}}">
    <!-- 订单头部 -->
    <view class="card">
      <view class="flex-row justify-between items-center">
        <text class="order-type-tag">{{orderType === 'PURCHASE' ? '采购' : '销售'}}</text>
        <status-tag status="{{order.status}}"></status-tag>
      </view>
      <text class="order-no">#{{order.orderNo}}</text>
      <text class="order-date">{{order.createdAt}}</text>
    </view>

    <!-- 往来方 & 仓库 -->
    <view class="card">
      <view class="info-row">
        <text class="info-label">{{orderType === 'PURCHASE' ? '供应商' : '客户'}}</text>
        <text class="info-value">{{orderType === 'PURCHASE' ? (order.supplier && order.supplier.name ? order.supplier.name : (order.supplierName || '-')) : (order.customer && order.customer.name ? order.customer.name : (order.customerName || '-'))}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">仓库</text>
        <text class="info-value">{{order.warehouse && order.warehouse.name ? order.warehouse.name : (order.warehouseName || '-')}}</text>
      </view>
      <view wx:if="{{order.remark}}" class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="card">
      <view class="section-header">
        <text class="section-title">商品明细</text>
        <text class="text-sm text-secondary">{{itemsCount}} 项</text>
      </view>
      <view class="divider"></view>
      <view wx:for="{{order.items}}" wx:key="id" class="product-row">
        <view class="flex-row justify-between items-start">
          <view class="flex-1">
            <text class="product-name">{{item.product && item.product.name ? item.product.name : (item.productName || '-')}}</text>
            <text class="product-spec">&yen;{{item.unitCost || item.unitPrice}} &times; {{item.quantity}}</text>
          </view>
          <text class="product-subtotal">&yen;{{item.subtotal}}</text>
        </view>
        <!-- Receive/deliver progress -->
        <view wx:if="{{orderType === 'PURCHASE' && item.receivedQty !== undefined}}" class="mt-4">
          <text class="text-xs text-secondary">已入库: {{item.receivedQty}} / {{item.quantity}}</text>
        </view>
        <view wx:elif="{{orderType === 'SALE' && item.deliveredQty !== undefined}}" class="mt-4">
          <text class="text-xs text-secondary">已出库: {{item.deliveredQty}} / {{item.quantity}}</text>
        </view>
        <!-- Per-item partial action for CONFIRMED status -->
        <view wx:if="{{order.status === 'CONFIRMED'}}" class="mt-8 flex-row items-center gap-8">
          <input class="form-input item-qty-input" type="digit" value="{{item._qty || item.quantity - (item.receivedQty || item.deliveredQty || 0)}}"
            data-index="{{index}}" data-id="{{item.id}}" bindinput="onItemQtyInput" />
          <button class="btn btn-primary btn-xs" data-index="{{index}}" data-id="{{item.id}}" bindtap="onItemAction">
            {{orderType === 'PURCHASE' ? '入库' : '出库'}}
          </button>
        </view>
      </view>
    </view>

    <!-- 合计 -->
    <view class="card flex-row justify-between items-center">
      <text class="text-base">合计</text>
      <text class="text-xl text-bold text-primary">&yen;{{order.totalAmount}}</text>
    </view>

    <!-- 操作按钮 -->
    <view wx:if="{{actions.length > 0}}" class="action-bar">
      <view class="flex-row gap-12">
        <button wx:for="{{actions}}" wx:key="action"
          class="btn {{item.type === 'danger' ? 'btn-danger' : item.type === 'secondary' ? 'btn-secondary' : 'btn-primary'}} flex-1"
          data-action="{{item.action}}"
          loading="{{actionLoading === item.action}}"
          disabled="{{actionLoading !== ''}}"
          bindtap="handleAction">{{item.label}}</button>
      </view>
    </view>
  </view>
</view>
