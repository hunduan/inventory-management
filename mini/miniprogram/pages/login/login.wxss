.login-page {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0 40px;
}

.login-logo {
  font-size: 64px;
  margin-bottom: 16px;
}

.login-title {
  font-size: 24px;
  font-weight: 700;
  color: #0f766e;
  margin-bottom: 8px;
}

.login-subtitle {
  font-size: 14px;
  color: #78716c;
}

.login-form {
  padding: 0 32px;
  flex: 1;
}

.login-btn {
  margin-top: 32px;
}

.login-footer {
  text-align: center;
  padding: 24px;
}

.login-footer-text {
  font-size: 12px;
  color: #a8a29e;
}
