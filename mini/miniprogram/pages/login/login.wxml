<view class="login-page">
  <view class="login-brand">
    <text class="login-logo">📦</text>
    <text class="login-title">进销存管理</text>
    <text class="login-subtitle">多租户库存管理系统</text>
  </view>
  <view class="login-card">
    <view class="form-group">
      <text class="form-label">邮箱</text>
      <input class="form-input" type="email" placeholder="请输入邮箱" value="{{email}}" bindinput="onEmailInput" />
    </view>
    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" type="password" placeholder="请输入密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <button class="btn btn-primary btn-block" loading="{{loading}}" disabled="{{loading || !email || !password}}" bindtap="onLogin">登录</button>
    <text wx:if="{{error}}" class="login-error">{{error}}</text>
  </view>
</view>
