<view class="page page-enter">
  <view class="section-header">
    <text class="section-title">商品列表</text>
    <button class="btn btn-primary btn-xs" bindtap="onAdd">+ 新增</button>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品名称或条码" value="{{searchQuery}}" bindinput="onSearchInput" bindconfirm="onSearch" />
  </view>

  <view wx:if="{{loading && products.length === 0}}" class="loading-center">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{products.length === 0}}" class="empty-state">
    <text class="empty-icon">📦</text>
    <text class="empty-text">{{searchQuery ? '未找到匹配商品' : '暂无商品'}}</text>
  </view>

  <view wx:else>
    <view class="card product-item" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="onEditProduct">
      <view class="flex-row justify-between items-center">
        <view class="flex-1">
          <view class="flex-row items-center">
            <text class="text-bold">{{item.name}}</text>
            <text wx:if="{{item.barcode}}" class="text-xs tag tag-blue ml-8">{{item.barcode}}</text>
          </view>
          <view class="flex-row mt-4">
            <text class="text-xs text-secondary">成本: ¥{{item.costPrice}}</text>
            <text class="text-xs text-secondary ml-16">售价: ¥{{item.salePrice}}</text>
          </view>
          <view wx:if="{{item.specs}}" class="flex-row flex-wrap mt-4">
            <text wx:for="{{Object.keys(item.specs)}}" wx:for-item="attrKey" wx:key="this" class="tag tag-default text-xs mr-4 mt-4">{{attrKey}}: {{item.specs[attrKey]}}</text>
          </view>
        </view>
        <text class="text-sm text-secondary">库存: {{item.stock || 0}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-center"><view class="loading-spinner"></view></view>
    <view wx:elif="{{!hasMore && products.length > 0}}" class="text-center text-muted text-sm" style="padding: 12px 0;">已加载全部</view>
  </view>
</view>
