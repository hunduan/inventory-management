.status-tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.6;
}

.status-tag-xs {
  padding: 1px 6px;
  font-size: 10px;
}

.status-draft {
  background: #f5f5f4;
  color: #78716c;
}

.status-confirmed {
  background: #eff6ff;
  color: #0284c7;
}

.status-received {
  background: #f0fdf4;
  color: #16a34a;
}

.status-delivered {
  background: #f0fdf4;
  color: #16a34a;
}

.status-cancelled {
  background: #fef2f2;
  color: #dc2626;
}

.status-progress {
  background: #fffbeb;
  color: #d97706;
}

.status-completed {
  background: #f0fdf4;
  color: #16a34a;
}

.status-default {
  background: #f5f5f4;
  color: #78716c;
}
