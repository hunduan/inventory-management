{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "strict": true,
    "types": ["miniprogram-api-typings"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["miniprogram/*"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "esModuleInterop": true
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules"]
}
