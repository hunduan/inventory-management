:root{--primary:#0f766e;--primary-hover:#0d9488;--bg:#f5f5f4;--surface:#fff;--text:#1c1917;--text-secondary:#78716c;--text-muted:#a8a29e;--border:#e7e5e4;--success:#16a34a;--warning:#d97706;--danger:#dc2626}body,page{background-color:var(--bg);box-sizing:border-box;color:var(--text);font-family:PingFang SC,Microsoft YaHei,system-ui,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.card{border-radius:8rpx}.badge{align-items:center;border-radius:4rpx;display:inline-flex;font-size:12rpx;font-weight:500;padding:2rpx 8rpx}.badge-success{background:#f0fdf4;color:#166534}.badge-warning{background:#fffbeb;color:#92400e}.badge-danger{background:#fef2f2;color:#dc2626}.badge-info{background:#f0f9ff;color:#075985}.input-field{background:var(--surface);border:1rpx solid var(--border);border-radius:6rpx;font-size:14rpx;outline:none;padding:8rpx 12rpx;transition:border-color .15s ease;width:100%}.input-field:focus{border-color:var(--primary)}@keyframes fadeInUp{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:translateY(0)}}.page-enter{animation:fadeInUp .25s ease forwards}.layout{background:var(--bg);display:flex;min-height:100vh}.sidebar{background:var(--surface);border-right:1rpx solid var(--border);box-shadow:0 1rpx 0 rgba(0,0,0,.02);display:flex;flex-direction:column;padding:12rpx 8rpx;width:240rpx}.sidebar.collapsed{width:72rpx}.sidebar-header{align-items:center;display:flex;gap:8rpx;padding:8rpx}.logo{align-items:center;background:var(--primary);border-radius:8rpx;color:#fff;display:flex;font-weight:700;height:36rpx;justify-content:center;width:36rpx}.logo-title{color:var(--text);font-weight:700;margin-left:6rpx}.collapse-btn{color:var(--text-secondary);cursor:pointer;margin-left:auto;padding:6rpx}.nav-list{display:flex;flex-direction:column;gap:6rpx;margin-top:12rpx}.nav-item{align-items:center;border-radius:8rpx;color:var(--text-secondary);cursor:pointer;display:flex;gap:10rpx;padding:10rpx 8rpx}.nav-item:hover{background:#f8faf9;color:var(--text)}.nav-item.active{background:linear-gradient(90deg,rgba(15,118,110,.06),transparent);color:var(--primary);font-weight:600}.nav-icon{text-align:center;width:28rpx}.nav-label{font-size:14rpx}.sidebar-footer{color:var(--text-muted);font-size:12rpx;margin-top:auto;padding:8rpx;text-align:center}.main-area{display:flex;flex:1;flex-direction:column}.topbar{align-items:center;background:transparent;border-bottom:1rpx solid transparent;display:flex;height:56rpx;justify-content:space-between;padding:0 16rpx}.user-chip{align-items:center;background:#f0fdfa;border-radius:18rpx;color:var(--primary);display:flex;font-weight:600;height:36rpx;justify-content:center;width:36rpx}.main-content{padding:20rpx 28rpx}.card{background:var(--surface);border:1rpx solid var(--border);border-radius:10rpx}.card.p-5{padding:20rpx}.kpi{border-radius:10rpx;box-shadow:0 1rpx 4rpx rgba(16,24,40,.03);padding:18rpx}